# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
DEEPSEEK_API_KEY="sk-YOUR_DEEPSEEK_KEY"

# GEMINI_API_KEY: 只有「看圖分析 K 線圖／截圖」需要（DeepSeek 無視覺能力），不設定則該功能停用
GEMINI_API_KEY=""

# AIRTAP_API_KEY: Personal Access Token for Airtop browser automation and web search.
AIRTAP_API_KEY="at-pat-YOUR_AIRTAP_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloud SQL Connection Variables (automatically injected at runtime)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# VITE_GOOGLE_CLIENT_ID: Required for Google Drive Integration
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Enable "Google Drive API" in the project.
# 3. Create OAuth Client ID (Web Application)
# 4. Add the APP_URL as an Authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
